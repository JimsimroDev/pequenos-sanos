# ─── Copia este archivo como .env y rellena los valores reales ────────────────
# cp .env.example .env
# El archivo .env NUNCA se sube al repositorio (está en .gitignore)

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=pequenos_sanos_db
DB_HOST=db
DB_PORT=5432

# ─── JWT (mínimo 32 caracteres) ───────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-minimum-32-characters-long

# ─── CORS — poner el origen del frontend en producción ────────────────────────
URL_CORS_PERMISSION=http://localhost:3000
